                "PUB_CACHE": "D:\\dev-cache\\pub-cache",
                "GRADLE_USER_HOME": "D:\\gradle-home"
            }
        },
        {
            "name": "src (release mode)",
            "cwd": "src frontend\\src",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolEnv": {
                "TEMP": "D:\\dev-cache\\temp",
                "TMP": "D:\\dev-cache\\temp",
                "PUB_CACHE": "D:\\dev-cache\\pub-cache",
                "GRADLE_USER_HOME": "D:\\gradle-home"
